@using diplom.Areas.AdminPanel.ViewModels
@model CategoryViewModel
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Create Category form</h4>
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label asp-for="Name">Category Name</label>
                        <input  class="form-control" asp-for="Name" placeholder="Category Name  ">
                        <span style="color:red" asp-validation-for="Name" ></span>
                    </div>
                    <button type="submit" class="btn btn-primary me-2" asp-action="Create" asp-controller="Category">Submit</button>
                    <button class="btn btn-light" asp-action="Index" asp-controller="Category">Cancel</button>
                </form>
            </div>
        </div>
    </div>
    </div>
