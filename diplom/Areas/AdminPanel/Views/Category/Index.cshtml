@using diplom.Models
@model IEnumerable<Category>
@{
    int count = 1;
}
<div class="row"> 
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Category table</h4>
         <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create Category</a>
            <div class="table-responsive pt-3">
                <table class="table table-dark">
                    <thead>
                        <tr>
                            <th>
                                Count
                            </th>
                            <th>
                                Category name
                            </th>
                            <th>
                                Settings
                            </th>
                            
                        </tr>
                    </thead>
                    <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>
                                        1
                                    </td>
                                    <td>
                                        @category.Name
                                    </td>
                                    <td>
                                        <button type="button"  class="btn btn-warning"><i class="mdi mdi-border-color"></i></button>
                                        <button type="button" class="btn btn-danger"><i class="mdi mdi-bookmark-remove"></i></button>
                                    </td>
                                    
                                </tr>
                                count++;
                            }
                            
                        </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>