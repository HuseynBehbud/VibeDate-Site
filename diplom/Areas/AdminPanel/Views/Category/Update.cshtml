@using diplom.Models

@model Category
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Update Category form</h4>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="Id" /> 
                    <div class="form-group">
                        <label asp-for="Name">Category Name</label>
                        <input class="form-control" asp-for="Name" placeholder="Category Name">
                        <span style="color:red" asp-validation-for="Name"></span>
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Submit</button>
                    <a class="btn btn-light" asp-action="Index" asp-controller="Category">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
