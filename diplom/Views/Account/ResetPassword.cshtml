@using diplom.ViewModel
@model ResetPasswordVM
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - VibeDate</title>
    <link rel="icon" type="image/png" href="~/assets/image/Apple-Touch-Icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&family=Montserrat:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body>
    <div class="login-bg-image"></div>

    <header class="header">
        <div class="header__container">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index"><img src="~/assets/image/Apple-Touch-Icon.png" alt="Logo Icon" class="logo-icon"></a>
                <a asp-controller="Home" asp-action="Index"><span class="logo-text">VibeDate</span></a>
            </div>
            <div class="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index" class="nav__link">Home</a>
                <a asp-controller="Home" asp-action="About" class="nav__link">About</a>
                <a asp-controller="Home" asp-action="Blog" class="nav__link">Blog</a>
                <a asp-controller="Home" asp-action="Plan" class="nav__link">Get Planning</a>
                <a asp-controller="Account" asp-action="Login" class="nav__link nav__link--active">Log In</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="login-wrapper">
            <div class="container">

                <h2 class="login-title">Reset your password to get back to planning</h2>

                <div id="error-box" class="error-box" style="display: none;"></div>
                <div class="text-danger" asp-validation-summary="ModelOnly"></div>

                <form method="post" class="login-form">
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="form-group">
                        <label asp-for="NewPassword">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control">
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control">
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-submit">Reset Password</button>
                </form>

                <a asp-action="Login" class="forgot-pass">Back to Login</a>

            </div>
        </section>

        <section class="join-section">
            <div class="container">

                <h2>Having trouble?</h2>
                <p>If you still can't access your account, contact support.</p>

                <a href="Contact" class="btn-join">
                    <span class="icon-box">
                        <i class="fa-regular fa-envelope"></i>
                    </span>
                    <span class="text-box"> Contact Us </span>
                </a>

            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p class="site-footer__text">
                Powered by the purring of 1,000 fluffy kittens - ABN 92 970 676 574
            </p>
            <div class="site-footer__actions">
                <a href="#" class="icon"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-twitter"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" class="icon"><i class="fa-solid fa-envelope"></i></a>
                <a href="#top" class="to-top"><i class="fa-solid fa-angle-up"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/assets/js/main.js"></script>
    @* Validasiya scriptlərini unutmayın *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>