<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Date Ideas (Free members) - VibeDate</title>
    <link rel="icon" type="image/png" href="~/assets/image/Apple-Touch-Icon.png">

    <link rel="apple-touch-icon" href="~/assets/image/Apple-Touch-Icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&family=Montserrat:wght@300;400&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body class="date-ideas-page">

    <header class="orbital-shells">
        <div class="flux-grid">
            <div class="logo">
                <a asp-controller="Home" asp-action="LogIndex">
                    <img src="~/assets/image/Apple-Touch-Icon.png" alt="Logo Icon"
                         class="logo-icon">
                </a>
                <a asp-controller="Home" asp-action="LogIndex"><span class="logo-text">VibeDate</span></a>
            </div>
            <div class="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>

            <nav class="nav">
                <a asp-controller="Home" asp-action="LogIndex" class="nav__link ">Home</a>
                <a asp-controller="Home" asp-action="LogAbout" class="nav__link">About</a>
                <a asp-controller="Home" asp-action="LogBlog" class="nav__link ">Blog</a>
                <a asp-controller="Home" asp-action="DateIdeas" class="nav__link nav__link--active">Date Ideas</a>
                <a asp-controller="Home" asp-action="PlanADate" class="nav__link">Plan A Date</a>

                <div class="prism-controller">
                    <button class="fusion-btn">My Account</button>
                    <div class="dark-matter-menu">
                        <a asp-controller="Home" asp-action="Settings" class="event-horizon-link">Settings</a>
                        <a asp-controller ="Home" asp-action="Index" class="event-horizon-link">Log Out</a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <section class="nene-sandigi">
            <div class="container">
                <div class="qara-toyuqlar">
                    <div class="qizil-baliq">
                        <label>Location</label>
                        <div class="tursh-alcha">
                            <select>
                                <option>Any Location</option>
                                <option>Brisbane</option>
                                <option>Melbourne</option>
                                <option>Sydney</option>
                            </select>
                        </div>
                    </div>
                    <div class="qizil-baliq">
                        <label>Date Types</label>
                        <div class="tursh-alcha">
                            <select>
                                <option>Any Date Type</option>
                                <option>Adventure Date</option>
                                <option>Romantic Date</option>
                            </select>
                        </div>
                    </div>
                    <div class="qizil-baliq">
                        <label>Cost for 2</label>
                        <div class="tursh-alcha">
                            <select>
                                <option>Any Budget</option>
                                <option>&lt; $200</option>
                                <option>Free</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="beton-qarishdiran">
            <div class="container">
                <div class="reqs-eden-deve">

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/punt-tours.jpg" alt="Lake">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Punting on the Lake</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Botanical Gardens</p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/tall-order.jpg" alt="Giraffes">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Tall Order</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Werribee Zoo</p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/butterfly.jpg" alt="Horses">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Gunnamatta Trail Rides</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Mornington</p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/afterthetears.jpg" alt="After The Tears">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">After The Tears</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Elsternwick</p>
                            <p class="card-description">
                                Polish food and drinks galore, and a cocktail list that will have your eyes rolling.
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/easeys.jpg" alt="Easey's Burger">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Easey’s Burger Joint</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Collingwood</p>
                            <p class="card-description">
                                Burgers on top of a building, inside a triplet of decommissioned trains. This is peak
                                Collingwood.
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/japan.jpg" alt="Samurai Retreat">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Samurai Retreat</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Montrose</p>
                            <p class="card-description">
                                Ever feel like indulging like a feudal warlord in Japan? The Japanese Retreat in Monrose
                                will give you and your partner just that experience.
                            </p>
                        </div>
                    </div>
                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/munich-brauhaus.jpg" alt="Munich Brauhaus">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Munich Brauhaus</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> South Wharf</p>
                            <p class="card-description">
                                Bavarian cuisine, plenty of beer, and an entertaining show ... Prost!
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/gunnamatta (1).png" alt="Gunnamatta Trail Rides">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Gunnamatta Trail Rides</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Mornington</p>
                            <p class="card-description">
                                Commanding a steed for a few hours with your partner makes you feel like a royal. Head
                                down to the beach and
                                experience their majestic strength.
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/breakroom.jpg" alt="The Break Room">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">The Break Room</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Collingwood</p>
                            <p class="card-description">
                                Ever feel like you have one of those Limp Bizkit days, where you just want to break
                                stuff? Well, now you get
                                the chance ...
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/berlin-bar.jpg" alt="Berlin Bar">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Berlin Bar</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Melbourne CBD</p>
                            <p class="card-description">
                                In this tucked away location, the Wall has yet to fall. And we’re talking about Trump’s
                                war. Achtung!
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/icehouse.jpg" alt="Icehouse Arena">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Icehouse Arena</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Docklands</p>
                            <p class="card-description">
                                Docklands is a bit of a strange place. On one hand, there's a huge wheel. And the other,
                                an ice skating
                                rink. Both are actually awesome!
                            </p>
                        </div>
                    </div>

                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/platypus.jpg" alt="Wade with the Platypus">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Wade with the Platypus</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Healesville</p>
                            <p class="card-description">
                                Cute and cuddly is synonymous with fun and romance. Wading with the platypus is peak
                                cute and cuddly.
                            </p>
                        </div>
                    </div>
                    <div class="plastik-stekan">
                        <div class="yagishli-hava">
                            <img src="~/assets/image/penguin.jpg" alt="Penguin Walk">
                        </div>
                        <div class="kartof-fri">
                            <h3><a href="#">Penguin Walk</a></h3>
                            <p><span class="elektrik-direyi">Where?</span> Melbourne CBD</p>
                            <p class="card-description">
                                Deep in the polar waters, their happy feet did dance. Just as they do in the Melbourne Aquarium. Nothing
                                like cute penguins to spruce up the romance.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <footer class="site-footer">
        <div class="site-footer__inner">
            <p class="site-footer__text">
                Powered by the purring of 1,000 fluffy kittens - ABN 92 970 676 574
            </p>
            <div class="site-footer__actions">
                <a href="https://www.facebook.com/vibedate" target="_blank" aria-label="Facebook" class="icon">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="https://x.com/vibedate" target="_blank" aria-label="Twitter" class="icon">
                    <i class="fa-brands fa-twitter"></i>
                </a>
                <a href="https://www.instagram.com/vibedate" target="_blank" aria-label="Instagram" class="icon">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="Email" class="icon"><i class="fa-solid fa-envelope"></i></a>
                <a href="#top" class="to-top" aria-label="Back to top"><i class="fa-solid fa-angle-up"></i></a>
            </div>
        </div>
    </footer>
    <script src="~/assets/js/main.js"></script>

</body>

</html>