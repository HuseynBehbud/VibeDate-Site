<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VibeDate - Your Personal Date Planner</title>
    <link rel="icon" type="image/png" href="~/assets/image/Apple-Touch-Icon.png">

    <link rel="apple-touch-icon" href="~/assets/image/Apple-Touch-Icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&family=Montserrat:wght@300;400&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>


<body>
    <header class="header">
        <div class="header__container">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index"><img src="~/assets/image/Apple-Touch-Icon.png" alt="Logo Icon" class="logo-icon"></a>
                <a asp-controller="Home" asp-action="Index"><span class="logo-text">VibeDate</span></a>
            </div>
            <div class="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index" class="nav__link nav__link--active">Home</a>
                <a asp-controller="Home" asp-action="About" class="nav__link">About</a>
                <a asp-controller="Home" asp-action="Blog" class="nav__link">Blog</a>
                <a asp-controller="Home" asp-action="Plan" class="nav__link">Get Planning</a>
                <a asp-controller="Home" asp-action="Log" class="nav__link nav__link--outline">Log In</a>
            </nav>
        </div>
    </header>
    <main>
        <section class="hero">
            <div class="hero__overlay"></div>
            <div class="hero__content">
                <h1 class="hero__title">Your Personal Date Planner</h1>
                <p class="hero__subtitle">
                    Unique and Personalised Dating Experiences
                </p>
                <a href="#" class="hero__button">Find Out More<i class="fa-solid fa-greater-than"></i></a>
            </div>
        </section>
        <section class="what-we-do">
            <div class="container">
                <h2 class="section-title">What We Do</h2>
                <p class="section-subtitle">We plan your dates, so you don't have to!</p>
                <p class="section-description">
                    VibeDate creates unique and personalised dating experiences for any occasion.
                </p>
                <div class="services">
                    <div class="service">
                        <img src="~/assets/image/whatwedo-01-firstdate.png" alt="First Dates">
                        <h3>First Dates</h3>
                        <p>
                            Get the sparks flying with something wacky and fun!
                            Or intimate and romantic. We have you covered.
                        </p>
                    </div>
                    <div class="service">
                        <img src="~/assets/image/whatwedo-02-datenight.png" alt="Date Nights">
                        <h3>Date Nights</h3>
                        <p>
                            Tired of the same old take away and a movie?
                            Spice up date night with something unique, planned by VibeDate!
                        </p>
                    </div>
                    <div class="service">
                        <img src="~/assets/image/whatwedo-03-anniversary.png" alt="Anniversaries">
                        <h3>Anniversaries</h3>
                        <p>
                            Anniversaries are our favourite. A true celebration of another year together.
                            Let's create a new tradition!
                        </p>
                    </div>
                    <div class="service">
                        <img src="~/assets/image/whatwedo-04-specialoc.png" alt="Everything Else">
                        <h3>Everything Else</h3>
                        <p>
                            And for everything else ... there's VibeDate!
                            Drinks with your bestie, dinner with the in-laws, anything. Let us help!
                        </p>
                    </div>
                </div>
                <div class="cta">
                    <a asp-controller="Home" asp-action="Plan" class="btn-primary">
                        Get planning <span>›</span>
                    </a>
                </div>
            </div>
        </section>
        <section class="plan">
            <div class="container">
                <h2 class="plan__title">What We Plan</h2>
                <p class="plan__subtitle">
                    A VibeDate can be an exciting adventure, or a romantic scavenger hunt.
                </p>
                <div class="plan__grid">
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-foodie.jpg" alt="Foodie Dates">
                        <p>
                            Relishing restaurants. Perfect park picnics.
                            Decadent desserts. Triple alliterations!
                        </p>
                    </div>
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-adventure.jpg" alt="Adventure Dates">
                        <p>
                            Fly the highest skies and surf the wildest waves,
                            all in the space of a day!
                        </p>
                    </div>
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-romantic.jpg" alt="Romantic Dates">
                        <p>
                            Imagine yachts, candlelight, and rose petals.
                            Need we say more?
                        </p>
                    </div>
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-nature.jpg" alt="Adventure Dates">
                        <p>
                            Get out and about and experience nature at its most
                            lovable!
                        </p>
                    </div>
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-bar.jpg" alt="Adventure Dates">
                        <p>
                            Head out and find some new watering holes to woo your
                            date!
                        </p>
                    </div>
                    <div class="plan-card">
                        <img src="~/assets/image/datetype-surprise.jpg" alt="Adventure Dates">
                        <p>
                            Want something entirely different? Personalised scavenger hunts are just one idea ...
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <section class="press">
            <div class="press__container">
                <div class="press__content">
                    <h2>What Others Are Saying</h2>
                    <p>
                        We've been making waves with the people who have experienced new dating
                        adventures through VibeDate!
                    </p>
                    <p>
                        Check us out around the interwebs and see what others have to say about us.
                    </p>
                </div>

                <div class="press__logos">
                    <div class="press__logo">
                        <a href="https://www.abc.net.au/listen/programs/radionational-drive/rn-drive-11.02.2016/7157170" target="_blank"><img src="~/assets/image/inthemedia-abc.png" alt="ABC Radio National"></a>
                    </div>
                    <div class="press__logo">
                        <a href="https://www.startup-buzz.com/vibedate-helps-users-plan-their-perfect-date/" target="_blank"><img src="~/assets/image/inthemedia-startupbuzz.png" alt="Startup Buzz"></a>
                    </div>
                    <div class="press__logo">
                        <a href="https://www.moo.com/blog/" target="_blank"><img src="~/assets/image/inthemedia-moo.png" alt="Moo"></a>
                    </div>
                    <div class="press__logo">
                        <a href="https://www.startupdaily.net/vibedate-injects-spontaneity-relationships-helping-couples-plan-fun-dates/" target="_blank"><img src="~/assets/image/inthemedia-startupdaily.png" alt="Startup Daily"></a>
                    </div>
                    <div class="press__logo">
                        <a href="https://smallbiztrends.com/insider-secrets-for-successfully-launching-a-startup/" target="_blank"><img src="~/assets/image/inthemedia-smallbus.png" alt="Small Business Trends"></a>
                    </div>
                    <div class="press__logo">
                        <a href="https://titanvine.com/2016/06/14/vibedate-startup-helps-users-plan-perfect-date/" target="_blank"><img src="~/assets/image/inthemedia-titanvine.png" alt="TitanVine"></a>
                    </div>
                </div>
            </div>
        </section>
        <section class="share-love">
            <h2>Share the Love!</h2>
        </section>
        <section class="ctas">
            <div class="ctas__content">
                <h3>Inject more romance into your dating life</h3>
                <p>Get planning your first VibeDate today</p>

                <a asp-controller="Home" asp-action="Plan" class="ctas__button">
                    <span class="ctas__icon"><i class="fa-regular fa-star"></i></span>
                    <span class="ctas__text">Get Planning</span>
                </a>
            </div>
        </section>
    </main>
    <footer class="site-footer">
        <div class="site-footer__inner">
            <p class="site-footer__text">
                Powered by the purring of 1,000 fluffy kittens - ABN 92 970 676 574
            </p>
            <div class="site-footer__actions">
                <a href="https://www.facebook.com/vibedate" target="_blank" aria-label="Facebook" class="icon"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://x.com/vibedate" target="_blank" aria-label="Twitter" class="icon"><i class="fa-brands fa-twitter"></i></a>
                <a href="https://www.instagram.com/vibedate" target="_blank" aria-label="Instagram" class="icon"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" aria-label="Email" class="icon"><i class="fa-solid fa-envelope"></i></a>
                <a href="#top" class="to-top" aria-label="Back to top"><i class="fa-solid fa-angle-up"></i></a>
            </div>
        </div>
    </footer>
    <script src="~/assets/js/main.js"></script>
</body>

</html>