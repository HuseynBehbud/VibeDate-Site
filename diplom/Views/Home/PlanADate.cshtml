<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Plan A Date (Free Member) - VibeDate</title>
    <link rel="icon" type="image/png" href="~/assets/image/Apple-Touch-Icon.png">

    <link rel="apple-touch-icon" href="~/assets/image/Apple-Touch-Icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&family=Montserrat:wght@300;400&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body>

    <header class="orbital-shells">
        <div class="flux-grid">
            <div class="logo">
                <a asp-controller="Home" asp-action="LogIndex">
                    <img src="~/assets/image/Apple-Touch-Icon.png" alt="Logo Icon"
                         class="logo-icon">
                </a>
                <a asp-controller="Home" asp-action="LogIndex"><span class="logo-text">VibeDate</span></a>
            </div>
            <div class="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>
            <nav class="nav">
                <a asp-controller="Home" asp-action="LogIndex" class="nav__link ">Home</a>
                <a asp-controller="Home" asp-action="LogAbout" class="nav__link">About</a>
                <a asp-controller="Home" asp-action="LogBlog" class="nav__link">Blog</a>
                <a asp-controller="Home" asp-action="DateIdeas" class="nav__link">Date Ideas</a>
                <a asp-controller="Home" asp-action="PlanADate" class="nav__link nav__link--active">Plan A Date</a>

                <div class="prism-controller">
                    <button class="fusion-btn">My Account</button>
                    <div class="dark-matter-menu">
                        <a asp-controller="Account" asp-action="Settings" class="event-horizon-link">Settings</a>
                        <a asp-controller="Home" asp-action="Index" class="event-horizon-link">Log Out</a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <section class="hero-section">
        </section>

        <section class="features-section">
            <div class="container">
                <h2 class="section-title">Ready to have a custom date planned for you?</h2>
                <p class="subtitle">Become a Full Member to speak directly to our Date Planners</p>
                <p class="small-text">Full Member benefits include ...</p>

                <div class="features-grid">
                    <div class="feature-item">
                        <div class="img-circle">
                            <img src="~/assets/image/dateplan1.jpg"
                                 alt="Newsletter">
                        </div>
                        <h3>Personalised Newsletter</h3>
                        <p>
                            Receive a weekly update of events that interest you. We tailor make the newsletter for your
                            dating life, based on your personalities.
                        </p>
                    </div>
                    <div class="feature-item">
                        <div class="img-circle">
                            <img src="~/assets/image/dateplan2.jpg"
                                 alt="Date Planners">
                        </div>
                        <h3>Real Date Planners</h3>
                        <p>
                            Planning an anniversary? Members can speak directly to our Date Planners and have an experience
                            tailor made. We are your personal date concierge.
                        </p>
                    </div>
                    <div class="feature-item">
                        <div class="img-circle">
                            <img src="~/assets/image/dateplan3.jpg"
                                 alt="Guarantee">
                        </div>
                        <h3>VibeDate Guarantee</h3>
                        <p>
                            For $10 per month, we will be your dating guardian angel. We promise to go above and beyond to
                            plan dates that suit you. Not happy? Cancel anytime.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="upgrade-section">
            <button class="btn btn-large-pink"><a asp-controller="Home" asp-action="LogPay">Upgrade now</a> <i class="fas fa-rocket"></i></button>
        </section>

        <section class="not-ready-banner">
            <h2>Not ready to upgrade?</h2>
        </section>

        <section class="ideas-intro">
            <h2>Check out some awesome date ideas</h2>
            <p>Pick a Date Type below to get started</p>
        </section>

        <section class="gallery-section">
            <div class="container">
                <div class="gallery-grid">
                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-foodie.jpg"
                                 alt="Foodie">
                        </div>
                        <div class="card-text">
                            <p>Relishing restaurants. Perfect park picnics. Decadent desserts. Triple alliterations!</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-adventure.jpg"
                                 alt="Adventure">
                        </div>
                        <div class="card-text">
                            <p>Fly the highest skies and surf the wildest waves, all in the space of a day!</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-romantic.jpg"
                                 alt="Romantic">
                        </div>
                        <div class="card-text">
                            <p>Imagine yachts, candlelight, and rose petals. Need we say more?</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-nature.jpg"
                                 alt="Nature">
                        </div>
                        <div class="card-text">
                            <p>Get out and about and experience nature at its most lovable!</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-bar.jpg"
                                 alt="Bar">
                        </div>
                        <div class="card-text">
                            <p>Head out and find some new watering holes to woo your date!</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image">
                            <img src="~/assets/image/datetype-surprise.jpg"
                                 alt="Surprise">
                        </div>
                        <div class="card-text">
                            <p>Want something entirely different? Personalised scavenger hunts are just one idea...</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <footer class="site-footer">
        <div class="site-footer__inner">
            <p class="site-footer__text">
                Powered by the purring of 1,000 fluffy kittens - ABN 92 970 676 574
            </p>
            <div class="site-footer__actions">
                <a href="https://www.facebook.com/vibedate" target="_blank" aria-label="Facebook" class="icon">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="https://x.com/vibedate" target="_blank" aria-label="Twitter" class="icon">
                    <i class="fa-brands fa-twitter"></i>
                </a>
                <a href="https://www.instagram.com/vibedate" target="_blank" aria-label="Instagram" class="icon">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="Email" class="icon"><i class="fa-solid fa-envelope"></i></a>
                <a href="#top" class="to-top" aria-label="Back to top"><i class="fa-solid fa-angle-up"></i></a>
            </div>
        </div>
    </footer>
    <script src="~/assets/js/main.js"></script>
</body>

</html>